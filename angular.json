{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "cli": { "analytics": false },
  "projects": { "clarifica": {
    "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
    "architect": {
      "build": {
        "builder": "@angular/build:application",
        "options": {
          "outputPath": "dist/clarifica", "index": "src/index.html", "browser": "src/main.ts",
          "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "inlineStyleLanguage": "scss",
          "assets": [{"glob":"**/*", "input":"src/assets", "output":"assets"}],
          "styles": ["src/styles.scss"]
        },
        "configurations": {
          "production": {"outputHashing":"all", "budgets":[{"type":"initial","maximumWarning":"1.5mb","maximumError":"2mb"}]},
          "development": {"optimization":false,"extractLicenses":false,"sourceMap":true}
        }, "defaultConfiguration": "production"
      },
      "serve": {"builder":"@angular/build:dev-server", "configurations":{
        "production":{"buildTarget":"clarifica:build:production"},
        "development":{"buildTarget":"clarifica:build:development"}
      },"defaultConfiguration":"development"}
    }
  }}
}
