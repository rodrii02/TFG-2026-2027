{
  "name": "microfoodscan",
  "version": "0.1.0",
  "private": true,
  "description": "Lectura local de matrices de señales LFA. Prototipo de TFG pendiente de calibración.",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run test:python && npm run sync && npm run verify:native",
    "sync": "npm run build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "verify:native": "node scripts/verify-native.mjs",
    "setup:python": "node scripts/prepare-python.mjs --download",
    "prebuild": "node scripts/prepare-python.mjs",
    "prestart": "node scripts/prepare-python.mjs",
    "test:python": "node scripts/test-python.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@ionic/angular": "9.0.5",
    "angular-cli-ghpages": "^3.1.0",
    "ionicons": "8.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.63.0",
    "pyodide": "314.0.7",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "packageManager": "npm@12.1.0"
}
